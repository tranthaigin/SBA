{
  "info": {
    "name": "A3TranQuocThai_SE1910 - requirements verification",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8083"
    }
  ],
  "item": [
    {
      "name": "Public rooms",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/rooms/public"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"roomId\",pm.response.json()[0].roomId);"
            ]
          }
        }
      ]
    },
    {
      "name": "Anonymous cannot manage customers",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/admin/customers"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\",()=>pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "Staff login from application.properties",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"staff@hotel.com\", \"password\": \"staff123\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"staffToken\",pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Staff customers",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{staffToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin/customers"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"customerId\",pm.response.json()[0].customerId);"
            ]
          }
        }
      ]
    },
    {
      "name": "Staff create offline booking",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{staffToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin/bookings",
        "body": {
          "mode": "raw",
          "raw": "{\"customerId\": \"{{customerId}}\", \"items\": [{\"roomId\": \"{{roomId}}\", \"startDate\": \"2027-03-01\", \"endDate\": \"2027-03-03\", \"actualPrice\": 100}]}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"bookingId\",pm.response.json().bookingReservationId);",
              "pm.test(\"Total is 200\",()=>pm.expect(Number(pm.response.json().totalPrice)).to.eql(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Staff edit booking detail",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{staffToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin/bookings/{{bookingId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"customerId\": \"{{customerId}}\", \"items\": [{\"roomId\": \"{{roomId}}\", \"startDate\": \"2027-03-01\", \"endDate\": \"2027-03-04\", \"actualPrice\": 100}]}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.test(\"Total is 300\",()=>pm.expect(Number(pm.response.json().totalPrice)).to.eql(300));"
            ]
          }
        }
      ]
    },
    {
      "name": "Staff delete test booking",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{staffToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin/bookings/{{bookingId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\",()=>pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Customer login JWT",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"customer@hotel.com\", \"password\": \"123456\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"customerToken\",pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Customer profile",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/customer/profile"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.test(\"Password omitted\",()=>pm.expect(pm.response.json()).not.to.have.property(\"password\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Customer history",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/customer/bookings"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Customer cannot manage customers",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin/customers"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\",()=>pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    }
  ]
}
