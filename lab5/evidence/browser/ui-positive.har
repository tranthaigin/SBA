            "size": 3272,
            "mimeType": "application/json",
            "compression": 0,
            "text": "[{\"orchidId\":1,\"orchidName\":\"White Phalaenopsis\",\"orchidDescription\":\"White Phalaenopsis moth orchid with a dark pink and yellow center.\",\"orchidCategory\":\"Phalaenopsis\",\"orchidURL\":\"https://upload.wikimedia.org/wikipedia/commons/4/49/Phalaenopsis_Orchid.jpg\",\"natural\":true,\"attractive\":true},{\"orchidId\":2,\"orchidName\":\"Cattleya Trianaei\",\"orchidDescription\":\"Large pale lavender Cattleya orchid with a ruffled magenta and yellow lip.\",\"orchidCategory\":\"Cattleya\",\"orchidURL\":\"https://cdn.shopify.com/s/files/1/0959/4313/1445/files/75c23c75-bbc0-4990-89e7-880ca1ae398a__83491.jpg?v=1774571823\",\"natural\":true,\"attractive\":true},{\"orchidId\":3,\"orchidName\":\"Pink Dendrobium\",\"orchidDescription\":\"Pink and white Dendrobium orchid with clusters of flowers along the stem.\",\"orchidCategory\":\"Dendrobium\",\"orchidURL\":\"https://4.bp.blogspot.com/-_Ny7GGEcHVM/Vh0DIHcewVI/AAAAAAAAAN8/lT07yDlah8Q/s1600/Dendrobium%2BOrchid%2BCare.jpg\",\"natural\":true,\"attractive\":true},{\"orchidId\":4,\"orchidName\":\"Cooktown Orchid\",\"orchidDescription\":\"Purple Cooktown orchid, also known as Dendrobium bigibbum.\",\"orchidCategory\":\"Dendrobium\",\"orchidURL\":\"https://upload.wikimedia.org/wikipedia/commons/thumb/8/8e/Cooktown_orchids_and_bud.jpg/500px-Cooktown_orchids_and_bud.jpg\",\"natural\":true,\"attractive\":true},{\"orchidId\":5,\"orchidName\":\"Lady Slipper Orchid\",\"orchidDescription\":\"Paphiopedilum orchid characterized by its distinctive slipper-shaped pouch.\",\"orchidCategory\":\"Paphiopedilum\",\"orchidURL\":\"https://secretgarden.ro/cdn/shop/products/image_71cd5445-7480-42e6-a6ad-c091e4097dd4.jpg?v=1676106611&width=3840\",\"natural\":true,\"attractive\":true},{\"orchidId\":6,\"orchidName\":\"Dancing Lady Orchid\",\"orchidDescription\":\"Yellow Oncidium orchid whose flowers resemble dancing ladies.\",\"orchidCategory\":\"Oncidium\",\"orchidURL\":\"https://images.squarespace-cdn.com/content/v1/64c524cb6ca49752316125a9/a2f5f5f8-1a23-4289-a9fc-f974043c9431/Oncidium%2BAlliance.jpg?format=2500w\",\"natural\":true,\"attractive\":true},{\"orchidId\":7,\"orchidName\":\"Orange Epidendrum\",\"orchidDescription\":\"Orange Epidendrum orchid with clusters of vivid orange and yellow flowers.\",\"orchidCategory\":\"Epidendrum\",\"orchidURL\":\"https://media.casaegiardino.it/images/2024/09/epidendrum-07.jpg\",\"natural\":true,\"attractive\":true},{\"orchidId\":8,\"orchidName\":\"Miltonia Pansy Orchid\",\"orchidDescription\":\"Magenta and white Miltonia orchid commonly known as the pansy orchid.\",\"orchidCategory\":\"Miltonia\",\"orchidURL\":\"https://www.mainau.de/sites/default/files/styles/squared_small/public/2025-03/5-miltonia-vko.jpg.webp?itok=-Ehee3V5\",\"natural\":true,\"attractive\":true},{\"orchidId\":9,\"orchidName\":\"Yellow Cymbidium\",\"orchidDescription\":\"Yellow Cymbidium orchid with deep red markings on the flower lip.\",\"orchidCategory\":\"Cymbidium\",\"orchidURL\":\"https://www.trianglenursery.co.uk/pictures/products/medium/CYMBIDIUM-ORCHID-COOKSBRIDGE-60cm.jpg\",\"natural\":true,\"attractive\":true},{\"orchidId\":10,\"orchidName\":\"Pink Veined Phalaenopsis\",\"orchidDescription\":\"Cultivated Phalaenopsis hybrid with pink veins and a deep magenta center.\",\"orchidCategory\":\"Phalaenopsis Hybrid\",\"orchidURL\":\"https://www.biosphaere-potsdam.de/fileadmin/_processed_/b/b/csm_Online-Ratespiel_Motiv-Phalaenopsis_1500px_0678bbccf0.jpg\",\"natural\":false,\"attractive\":true}]"
