{
  "info": {
    "name": "SBA301 Slot18 Orchid API",
    "description": "Run in order. T11 SQL/FK and T12 restart are verified separately with scripts/verify-api.ps1 -VerifyDatabase -Restart.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "secondCategoryId",
      "value": ""
    },
    {
      "key": "orchidId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "PRE - Discover category IDs",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/categories"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Two categories available\",()=>pm.expect(pm.response.json().length).to.be.at.least(2));",
              "const c=pm.response.json(); pm.collectionVariables.set(\"categoryId\",c[0].categoryId); pm.collectionVariables.set(\"secondCategoryId\",c[1].categoryId);"
            ]
          }
        }
      ]
    },
    {
      "name": "T05 - Create Orchid",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/orchids",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orchidID\": 999999,\n  \"orchidName\": \"Postman Lab4 Orchid\",\n  \"isNatural\": true,\n  \"orchidDescription\": \"Hoa lan kiem thu Lab4\",\n  \"orchidCategory\": {\n    \"categoryId\": {{categoryId}}\n  },\n  \"isAttractive\": true,\n  \"orchidURL\": \"https://example.com/orchid.jpg\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Generated identity\",()=>{pm.expect(pm.response.json().orchidID).to.be.above(0); pm.expect(pm.response.json().orchidID).not.to.eql(999999);});",
              "pm.collectionVariables.set(\"orchidId\",pm.response.json().orchidID);"
            ]
          }
        }
      ]
    },
    {
      "name": "T01 - List",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/orchids"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Array\",()=>pm.expect(pm.response.json()).to.be.an(\"array\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "T02 - Search",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/orchids?name=postman%20lab4"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Matching names\",()=>{const rows=pm.response.json(); pm.expect(rows.length).to.be.above(0); rows.forEach(o=>pm.expect(o.orchidName.toLowerCase()).to.include(\"postman lab4\"));});"
            ]
          }
        }
      ]
    },
    {
      "name": "T03 - GET postcondition",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/orchids/{{orchidId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"POST persisted\",()=>{const o=pm.response.json(); pm.expect(o.orchidName).to.eql(\"Postman Lab4 Orchid\"); pm.expect(String(o.orchidCategory.categoryId)).to.eql(String(pm.collectionVariables.get(\"categoryId\"))); pm.expect(o.isNatural).to.eql(true); pm.expect(o.orchidCategory).not.to.have.property(\"orchids\");});"
            ]
          }
        }
      ]
    },
    {
      "name": "T04 - Missing",
