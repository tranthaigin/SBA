{
  "info": {
    "name": "SBA301 Lab03 Employee API",
    "description": "Slot15/16 core Employee API; ordered scenario uses disposable E901 and ends by deleting it. Run against a freshly started Lab03 (30 seeds).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8083",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "T01 Baseline thirty employees",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/employees"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"30 seeds and 3 pages\", () => { const b=pm.response.json(); pm.expect(b.totalElements).to.eql(30); pm.expect(b.totalPages).to.eql(3); pm.expect(b.content).to.have.length(10); });"
            ]
          }
        }
      ]
    },
    {
      "name": "T02 V1 four fields",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/employees/E001"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"V1 contract\", () => pm.expect(Object.keys(pm.response.json()).sort()).to.eql([\"designation\",\"empId\",\"empName\",\"salary\"]));"
            ]
          }
        }
      ]
    },
    {
      "name": "T03 V2 extra fields",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v2/employees/E001"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"V2 contract\", () => {const b=pm.response.json(); pm.expect(b.email).to.eql(\"employee01@example.com\"); pm.expect(b.department).to.eql(\"Engineering\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "T04 Page zero",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/employees?page=0&size=5"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const b=pm.response.json(); pm.collectionVariables.set(\"pageZero\", JSON.stringify(b.content.map(e=>e.empId))); pm.test(\"page 0 content\", () => {pm.expect(b.content.map(e=>e.empId)).to.eql([\"E001\",\"E002\",\"E003\",\"E004\",\"E005\"]); pm.expect(b.page).to.eql(0); pm.expect(b.hasPrevious).to.eql(false);});"
            ]
          }
        }
      ]
    },
    {
      "name": "T05 Page one",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/employees?page=1&size=5"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"disjoint pages and metadata\", () => {const b=pm.response.json(); pm.expect(b.content.map(e=>e.empId)).to.eql([\"E006\",\"E007\",\"E008\",\"E009\",\"E010\"]); pm.expect(b.totalPages).to.eql(6); pm.expect(b.hasPrevious).to.eql(true); pm.expect(b.content.map(e=>e.empId).filter(id=>JSON.parse(pm.collectionVariables.get(\"pageZero\")).includes(id))).to.eql([]);});"
            ]
          }
        }
      ]
    },
    {
      "name": "T06 Salary asc",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/employees?size=100&sort=salary,asc"
