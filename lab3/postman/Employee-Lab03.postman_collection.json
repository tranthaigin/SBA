        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"numeric salary order\", () => { const v=pm.response.json().content.map(e=>e.salary); pm.expect(v).to.eql([...v].sort((a,b)=>a-b)); });"
            ]
          }
        }
      ]
    },
