            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Seed page\", () => { const p=pm.response.json(); pm.expect(p.content.length).to.eql(3); pm.expect(p.totalElements).to.eql(3); pm.expect(p.size).to.eql(10); });"
